# =====================================================================
# Mi Huerto - Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio.
# =====================================================================

# --- Supabase (cliente y servidor) ---
# URL pública del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Clave publishable / anon (segura para el navegador, protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (solo servidor) ---
# Clave service_role: SALTA RLS. Úsala únicamente en código de servidor
# (API routes, server actions). NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meteorología (Open-Meteo no requiere API key) ---
# Base de la API meteorológica. Open-Meteo es gratuita y sin clave.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
